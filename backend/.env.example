# ============================================================
# Skating Store API — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials to version control.
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/skating_store

# JWT secret — generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=

# Server port
PORT=4000

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Resend API key for transactional emails
# Get yours at https://resend.com
RESEND_API_KEY=

# Google OAuth 2.0 Client ID
# Configure at https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# Frontend URL (for email links, redirects)
FRONTEND_URL=https://yourdomain.com

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Logging
LOG_LEVEL=info
# NODE_ENV=production

# Database pool tuning (optional)
# DB_POOL_MAX=20
